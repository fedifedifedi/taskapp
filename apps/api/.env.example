# Copier ce fichier en .env (cp .env.example .env) puis adapter les valeurs.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL local (docker compose : npm run db:up)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskapp

# Secret de signature des JWT : 32 caractères minimum, aléatoire.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=1d

# Limitation de débit sur /api/v1/auth (requêtes par fenêtre de 15 min et par IP)
AUTH_RATE_LIMIT_MAX=20
